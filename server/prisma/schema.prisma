// EcoSphere ESG Platform - Prisma Schema (Phase 1)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum CategoryType {
  CSR_ACTIVITY
  CHALLENGE
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum UnlockRule {
  XP_THRESHOLD
  CHALLENGE_COUNT
}

enum OperationalType {
  PURCHASE
  MANUFACTURING
  EXPENSE
  FLEET
}

// ---------- Users & Org ----------
model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  role               Role                 @default(EMPLOYEE)
  points             Int                  @default(0)
  xp                 Int                  @default(0)
  status             Status               @default(ACTIVE)
  departmentId       String?
  department         Department?          @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headOf             Department?          @relation("DepartmentHead")
  operationalRecords OperationalRecord[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Department {
  id                 String               @id @default(cuid())
  name               String
  code               String               @unique
  headId             String?              @unique
  head               User?                @relation("DepartmentHead", fields: [headId], references: [id])
  parentId           String?
  parent             Department?          @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children           Department[]         @relation("DepartmentHierarchy")
  members            User[]               @relation("DepartmentMembers")
  goals              EnvironmentalGoal[]
  operationalRecords OperationalRecord[]
  carbonTransactions CarbonTransaction[]
  employeeCount      Int                  @default(0)
  status             Status               @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

// ---------- Master Data ----------
model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  status    Status       @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model EmissionFactor {
  id                 String              @id @default(cuid())
  name               String
  source             String // e.g. "Diesel", "Electricity"
  unit               String // e.g. "litre", "kWh"
  factor             Float // kgCO2 per unit
  status             Status              @default(ACTIVE)
  operationalRecords OperationalRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ProductESGProfile {
  id            String   @id @default(cuid())
  productName   String
  category      String
  carbonPerUnit Float
  recyclablePct Float?
  notes         String?
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EnvironmentalGoal {
  id           String      @id @default(cuid())
  title        String
  description  String?
  targetValue  Float
  currentValue Float       @default(0)
  unit         String
  deadline     DateTime?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  status       GoalStatus  @default(ON_TRACK)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ESGPolicy {
  id            String   @id @default(cuid())
  title         String
  description   String
  version       String   @default("1.0")
  effectiveDate DateTime @default(now())
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Badge {
  id          String     @id @default(cuid())
  name        String
  description String
  unlockRule  UnlockRule
  threshold   Int
  icon        String     @default("🏅")
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Reward {
  id             String   @id @default(cuid())
  name           String
  description    String
  pointsRequired Int
  stock          Int      @default(0)
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- Phase 2: Environmental ----------
model OperationalRecord {
  id                String            @id @default(cuid())
  type              OperationalType
  description       String
  quantity          Float             // amount of unit consumed
  unit              String            // e.g. litres, kWh
  emissionFactorId  String
  emissionFactor    EmissionFactor    @relation(fields: [emissionFactorId], references: [id])
  departmentId      String
  department        Department        @relation(fields: [departmentId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  carbonTransaction CarbonTransaction?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CarbonTransaction {
  id                  String             @id @default(cuid())
  operationalRecordId String?            @unique
  operationalRecord   OperationalRecord? @relation(fields: [operationalRecordId], references: [id])
  description         String
  emissions           Float              // kgCO2
  departmentId        String
  department          Department         @relation(fields: [departmentId], references: [id])
  recordedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ---------- Settings (single row, id = 1) ----------
model Setting {
  id               Int      @id @default(1)
  autoEmission     Boolean  @default(false)
  evidenceRequired Boolean  @default(true)
  badgeAutoAward   Boolean  @default(true)
  weightEnv        Int      @default(40)
  weightSocial     Int      @default(30)
  weightGov        Int      @default(30)
  updatedAt        DateTime @updatedAt
}
