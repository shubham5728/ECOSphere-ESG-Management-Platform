// EcoSphere ESG Platform - Prisma Schema (Phase 1 → Phase 8)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum CategoryType {
  CSR_ACTIVITY
  CHALLENGE
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum UnlockRule {
  XP_THRESHOLD
  CHALLENGE_COUNT
}

enum OperationalType {
  PURCHASE
  MANUFACTURING
  EXPENSE
  FLEET
}

enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum NotificationType {
  BADGE_AWARDED
  CHALLENGE_CLOSED
  CHALLENGE_APPROVED
  CHALLENGE_REJECTED
  COMPLIANCE_OVERDUE
  REWARD_REDEEMED
  GENERAL
}

// ---------- Users & Org ----------
model User {
  id                  String                 @id @default(cuid())
  name                String
  email               String                 @unique
  passwordHash        String
  role                Role                   @default(EMPLOYEE)
  points              Int                    @default(0)
  xp                  Int                    @default(0)
  status              Status                 @default(ACTIVE)
  departmentId        String?
  department          Department?            @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headOf              Department?            @relation("DepartmentHead")
  operationalRecords  OperationalRecord[]
  participations      Participation[]
  acknowledgements    PolicyAcknowledgement[]
  ownedIssues         ComplianceIssue[]      @relation("IssueOwner")
  challengeSignups    ChallengeParticipation[]
  badges              UserBadge[]
  redemptions         RewardRedemption[]
  notifications       Notification[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model Department {
  id                 String               @id @default(cuid())
  name               String
  code               String               @unique
  headId             String?              @unique
  head               User?                @relation("DepartmentHead", fields: [headId], references: [id])
  parentId           String?
  parent             Department?          @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children           Department[]         @relation("DepartmentHierarchy")
  members            User[]               @relation("DepartmentMembers")
  goals              EnvironmentalGoal[]
  operationalRecords OperationalRecord[]
  carbonTransactions CarbonTransaction[]
  csrActivities      CsrActivity[]
  socialMetrics      SocialMetric[]
  audits             Audit[]
  complianceIssues   ComplianceIssue[]
  employeeCount      Int                  @default(0)
  status             Status               @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

// ---------- Master Data ----------
model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  status    Status       @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model EmissionFactor {
  id                 String              @id @default(cuid())
  name               String
  source             String // e.g. "Diesel", "Electricity"
  unit               String // e.g. "litre", "kWh"
  factor             Float // kgCO2 per unit
  status             Status              @default(ACTIVE)
  operationalRecords OperationalRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ProductESGProfile {
  id            String   @id @default(cuid())
  productName   String
  category      String
  carbonPerUnit Float
  recyclablePct Float?
  notes         String?
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EnvironmentalGoal {
  id           String      @id @default(cuid())
  title        String
  description  String?
  targetValue  Float
  currentValue Float       @default(0)
  unit         String
  deadline     DateTime?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  status       GoalStatus  @default(ON_TRACK)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ESGPolicy {
  id               String                 @id @default(cuid())
  title            String
  description      String
  version          String                 @default("1.0")
  effectiveDate    DateTime               @default(now())
  status           Status                 @default(ACTIVE)
  acknowledgements PolicyAcknowledgement[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  unlockRule  UnlockRule
  threshold   Int
  icon        String      @default("🏅")
  status      Status      @default(ACTIVE)
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Reward {
  id             String             @id @default(cuid())
  name           String
  description    String
  pointsRequired Int
  stock          Int                @default(0)
  status         Status             @default(ACTIVE)
  redemptions    RewardRedemption[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// ---------- Phase 2: Environmental ----------
model OperationalRecord {
  id                String            @id @default(cuid())
  type              OperationalType
  description       String
  quantity          Float             // amount of unit consumed
  unit              String            // e.g. litres, kWh
  emissionFactorId  String
  emissionFactor    EmissionFactor    @relation(fields: [emissionFactorId], references: [id])
  departmentId      String
  department        Department        @relation(fields: [departmentId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  carbonTransaction CarbonTransaction?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CarbonTransaction {
  id                  String             @id @default(cuid())
  operationalRecordId String?            @unique
  operationalRecord   OperationalRecord? @relation(fields: [operationalRecordId], references: [id])
  description         String
  emissions           Float              // kgCO2
  departmentId        String
  department          Department         @relation(fields: [departmentId], references: [id])
  recordedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ---------- Phase 3: Social ----------
model CsrActivity {
  id             String          @id @default(cuid())
  title          String
  description    String
  categoryId     String?
  startDate      DateTime
  endDate        DateTime?
  location       String?
  maxParticipants Int?           
  xpReward       Int             @default(50)
  pointsReward   Int             @default(100)
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
  participations Participation[]
  status         Status          @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Participation {
  id            String              @id @default(cuid())
  csrActivityId String
  csrActivity   CsrActivity         @relation(fields: [csrActivityId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  proofUrl      String?             // link or file path (evidence)
  proofNote     String?             // description of proof
  status        ParticipationStatus @default(PENDING)
  reviewNote    String?             // reviewer comment
  xpAwarded     Int                 @default(0)
  pointsAwarded Int                 @default(0)
  submittedAt   DateTime            @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([csrActivityId, userId])
}

model SocialMetric {
  id               String      @id @default(cuid())
  departmentId     String
  department       Department  @relation(fields: [departmentId], references: [id])
  period           String      // e.g. "2024-Q1", "2024-H1"
  totalEmployees   Int         @default(0)
  femaleCount      Int         @default(0)
  trainingHours    Float       @default(0)
  safetyIncidents  Int         @default(0)
  volunteerHours   Float       @default(0)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ---------- Phase 4: Governance ----------
model PolicyAcknowledgement {
  id          String    @id @default(cuid())
  policyId    String
  policy      ESGPolicy @relation(fields: [policyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  acknowledgedAt DateTime @default(now())

  @@unique([policyId, userId])
}

model Audit {
  id           String     @id @default(cuid())
  title        String
  auditor      String     // e.g. "PwC", "Internal Team"
  auditDate    DateTime
  rating       String     // e.g. "EXCELLENT", "SATISFACTORY", "NEEDS_IMPROVEMENT"
  score        Float?     // optional numeric score (e.g. 0-100)
  findings     String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ComplianceIssue {
  id           String     @id @default(cuid())
  title        String
  description  String
  severity     String     // e.g. "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status       String     // e.g. "OPEN", "IN_PROGRESS", "RESOLVED"
  dueDate      DateTime
  resolvedAt   DateTime?
  ownerId      String
  owner        User       @relation("IssueOwner", fields: [ownerId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ---------- Phase 5: Gamification ----------
model Challenge {
  id              String                 @id @default(cuid())
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime
  xpReward        Int                    @default(100)
  pointsReward    Int                    @default(200)
  status          ChallengeStatus        @default(DRAFT)
  participations  ChallengeParticipation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ChallengeParticipation {
  id            String              @id @default(cuid())
  challengeId   String
  challenge     Challenge           @relation(fields: [challengeId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  proofUrl      String?
  proofNote     String?
  status        ParticipationStatus @default(PENDING)
  reviewNote    String?
  submittedAt   DateTime            @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([challengeId, userId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  redeemedAt  DateTime @default(now())
}

// ---------- Settings (single row, id = 1) ----------
model Setting {
  id               Int      @id @default(1)
  autoEmission     Boolean  @default(false)
  evidenceRequired Boolean  @default(true)
  badgeAutoAward   Boolean  @default(true)
  weightEnv        Int      @default(40)
  weightSocial     Int      @default(30)
  weightGov        Int      @default(30)
  updatedAt        DateTime @updatedAt
}

// ---------- Phase 8: Notifications ----------
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}
